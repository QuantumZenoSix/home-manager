#!/usr/bin/env bash


# Main util functions
# This file holds many utility functions that contain one or more commands in succession to achieve some goal
# Every one begins with 'ut_' (utility)




# ____________________ GENERAL ______________________


# ────────────────────────────────────────────────
#             text 
# ────────────────────────────────────────────────

ut_txt_docx_to_md() {
    # Check if pandoc is installed
    command -v pandoc >/dev/null 2>&1 || { echo "pandoc is required but not installed" >&2; exit 1; }
    # Validate input file
    [[ -z "$1" || ! "$1" =~ \.docx$ ]] && { echo "File must be in .docx format" >&2; exit 1; }

    [[ ! -f "$1" || ! -r "$1" ]] && { echo "File does not exist or is not readable" >&2; exit 1; }

    # Validate second argument
    if [[ -n "$2" && "$2" != "--preserve-img-dimensions" ]]; then
        echo "Invalid argument: $2. Only --preserve-img-dimensions is supported" >&2
        exit 1
    fi

    # Process file name
    FILE=$(basename "$1")
    FILE=${FILE// /_}
    FILE=${FILE%.docx}

    # Check for existing output file
    [[ -f "$FILE.md" ]] && { echo "Output file $FILE.md already exists" >&2; exit 1; }

    # Create unique media folder
    MEDIA_DIR="_assets_${FILE}"
    [[ -d "$MEDIA_DIR" ]] && { echo "Media directory $MEDIA_DIR already exists" >&2; exit 1; }

    # Convert file
    if [[ "$2" == "--preserve-img-dimensions" ]]; then
        pandoc -s "$1" -f docx -t gfm --extract-media="$MEDIA_DIR" -o "$FILE.md" --wrap=auto --columns=80
        printf "Created file %s.md with media extracted\n" "$FILE"
    else
        # Remove any fixed image dimentions. Useful as sometimes this will causes images to use html syntax as markdown since this is the only way to set specific dimensions in an  image in markdown
        printf "About to create file %s.md...\n" "$FILE"
        FILTER_FILE=$(mktemp filter.XXXXXX.lua)
        /usr/bin/cat <<EOF > "$FILTER_FILE"
function Image (img)
    img.attributes.width = nil
    img.attributes.height = nil
    return img
end
EOF
        pandoc -s "$1" -f docx -t gfm --extract-media="$MEDIA_DIR" -o "$FILE.md" --wrap=auto --columns=80 --lua-filter="$FILTER_FILE"
        rm -f "$FILTER_FILE"
        printf "Created file %s.md\n" "$FILE"
    fi

    # Remove broken image links
    sed -i -E ':a; N; $!ba; s:(!\[([^]\n])*)(\n\s*):\1\ :g' "$FILE.md"

}

ut_txt_list_difference(){
    # What lines are in list 2 that arent in list 1

    # Check if exactly two arguments are provided
    if [ "$#" -ne 2 ]; then
        echo "See which lines are in list 2 that arent in list 1"
        echo "Error: Exactly 2 arguments required, but $# provided." >&2
        return 1
    fi

    grep -F -x -v -f ${1} ${2}

}

# ────────────────────────────────────────────────
#             sys
# ────────────────────────────────────────────────

ut_sys_detect_distro_type(){
    # returns debian|fedora|arch|null
    if [ -f /etc/os-release ]; then
        # shellcheck disable=SC1091
        . /etc/os-release
    else
        echo "null"
        return
        # echo "Error: /etc/os-release not found — cannot reliably detect distribution"
    fi

    ID_LIKE="${ID_LIKE:-$ID}"
    ID_LIKE=$(echo "$ID_LIKE" | tr '[:upper:]' '[:lower:]')

    if echo "$ID_LIKE" | grep -q -E 'debian|ubuntu|pop|linuxmint|zorin'; then
        DISTRO_FAMILY="debian"
    elif echo "$ID" "$ID_LIKE" | grep -q -E 'fedora|nobara|rhel|centos|rocky|almalinux'; then
        DISTRO_FAMILY="fedora"
    elif echo "$ID" "$ID_LIKE" | grep -q -E 'arch|cachy'; then
        DISTRO_FAMILY="arch"
    else
        DISTRO_FAMILY="null"
    fi

    echo "${DISTRO_FAMILY}"
}

ut_sys_create_and_assume_user(){
    if [[ -z "$1" ]]; then
        echo "[!] Usage: create_and_assume_user <username>"
        echo "    Requires username as an argument"
        return 1
    fi

    local user="$1"

    local distro_family=$(ut_sys_detect_distro_type)
    local super_group="sudo"

    if [[ "$distro_family" == "arch" || "$distro_family" == "fedora" ]]; then
        super_group="wheel"
    fi

    # Decide whether we need sudo or not
    if [[ "$EUID" -eq 0 ]]; then
        # Already root → no sudo needed
        useradd -m "$user" &&
        usermod -aG ${super_group} "$user" &&
        passwd "$user" &&
        su - "$user"
    else
        # Not root → use sudo
        sudo useradd -m "$user" &&
        sudo user
        sudo passwd "$user" &&
        sudo -i -u "$user"
    fi
}


ut_sys_restart_audio(){

    systemctl --user restart wireplumber pipewire pipewire-pulse

}

ut_sys_change_pop_graphics(){

    if [[ "${1}" = "low" ]]; then
        sudo system76-power graphics integrated # iGPU only (best battery, no NVIDIA)
    elif [[ "${1}" = "med" ]]; then
        sudo system76-power graphics hybrid    # default & most battery-friendly

    elif [[ "${1}" = "high" ]]; then
        sudo system76-power graphics nvidia    # max performance (uses more power)
    else
        echo "Options are 'low' | 'med' | 'high'"
    fi

    echo 

    local current=$(system76-power graphics )
    echo "Current: $current"
}

ut_sys_view_incoming_requests(){
    local PORT=
    if [ -z "${PORT}" ]; then
        echo "no port passed in, defaulting to 22 (ssh)"
        PORT=22
    fi
    sudo tcpdump --direction=in port ${PORT}   -i wlan0 -v
}

ut_sys_update_nvidia_drivers_arch(){
    sudo pacman -Syu nvidia-utils lib32-nvidia-utils opencl-nvidia lib32-opencl-nvidia   
    nvidia-smi
}

ut_ufw_only_allow_tailscale(){
    sudo ufw allow in on tailscale0
    sudo ufw default allow outgoing
    sudo ufw enable
    sudo ufw reload
    sudo ufw status verbose
    tailscale status
}


