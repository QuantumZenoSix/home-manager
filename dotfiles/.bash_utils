ut_o_create_systemd_service(){

    # Enforce sudo/root
    # if [ "$(id -u)" -ne 0 ]; then
    #         echo "User is not running as root or with sudo. Exiting..."
    #         exit;
    # fi

    COLUMNS=1
    echo ""
    echo "Select the user the service should run as: "
    PS3="Enter a number: "
    select SERVICE_USER in $(grep -v 'nologin' /etc/passwd | awk -F: '{ print $1 }' )
    do

        echo ""
        echo "How often should this run?"
        PS3="Enter a number: "
        select choice in \
            "Daily at 2:30 AM" \
            "Daily (midnight)" \
            "Weekly" \
            "Monthly" \
            "Every 6 hours" \
            "Every 12 hours" \
            "Every 3 days" \
            "Quit"
        do
            case "$choice" in
                "Daily at 2:30 AM")
                    TIMER_DIRECTIVE="OnCalendar=*-*-* 02:30:00"
                    ;;
                "Daily (midnight)")
                    TIMER_DIRECTIVE="OnCalendar=daily"
                    ;;
                "Weekly")
                    TIMER_DIRECTIVE="OnCalendar=weekly"
                    ;;
                "Monthly")
                    TIMER_DIRECTIVE="OnCalendar=monthly"
                    ;;
                "Every 6 hours")
                    TIMER_DIRECTIVE="OnUnitActiveSec=6h"
                    ;;
                "Every 12 hours")
                    TIMER_DIRECTIVE="OnUnitActiveSec=12h"
                    ;;
                "Every 3 days")
                    TIMER_DIRECTIVE="OnUnitActiveSec=3d"
                    ;;
                "Quit")
                    echo "Exiting."
                    return 0  # or exit 0 if not in a function
                    ;;
                *)
                    echo "Invalid option. Please try again."
                    continue
                    ;;
            esac

            printf "\nEnter a brief description (optional): "
            read DESC

            # Remove any trailing '.sh'
            PRGRM=$(basename $1)
            PRGRM="${PRGRM%.sh}"

            sudo cp $1 /usr/local/bin/$PRGRM

            if [[ -e /usr/local/bin/$PRGRM ]]; then

                    echo copied file...
                    sudo chmod +x /usr/local/bin/$PRGRM
                    SERVICE_UNITFILE=/etc/systemd/system/
                    PROGRAM_LOCATION=/usr/local/bin/$PRGRM
                    sudo chmod +x $PROGRAM_LOCATION

                    # Create service
                    printf "[Unit]\nDescription=$DESC\n\n[Service]\nType=oneshot\n\nUser=${SERVICE_USER}\nExecStart=$PROGRAM_LOCATION\nTimeoutStartSec=45min\nRemainAfterExit=yes\n" |  sudo tee $SERVICE_UNITFILE$PRGRM.service > /dev/null

                    # Create timer
                    printf "[Unit]\nDescription=$DESC (timer)\n\n[Timer]\n$TIMER_DIRECTIVE\nPersistent=true\nUnit=$PRGRM.service\n\n[Install]\nWantedBy=timers.target\n" | sudo tee $SERVICE_UNITFILE$PRGRM.timer > /dev/null

                    sudo systemctl daemon-reload
                    sudo systemctl enable $PRGRM.service
                    # sudo systemctl start $PRGRM
                    sudo systemctl start $PRGRM.timer
                    sudo systemctl enable $PRGRM.timer

                    sudo systemctl status $PRGRM.service
                    sudo systemctl status $PRGRM.timer

                    echo "Service installed!"
                    # exit
                    return

            else
                    echo "Unable to copy file to /usr/local/bin/ . Exiting."
            fi

        done

    done

}

ut_o_run_ollama_webui(){
    sudo docker pull ghcr.io/open-webui/open-webui:main
    sudo docker run -d -p 3000:8080 -v open-webui:/app/backend/data --name open-webui ghcr.io/open-webui/open-webui:main
}

alias ollama_webui="ut_o_run_ollama_webui"

ut_o_openvpn(){
    local VPN_FILE=~/Documents/PBX/vpn/openvpn_bobby.valenzuela.ovpn
    local PROFILE_NAME='bobby.valenzuela'
    local CONNECTION_EXISTS=$(nmcli connection show | grep 'openvpn_bobby.valenzuela' | wc -l)

    if [[ ${CONNECTION_EXISTS} -eq 0 ]];then
        echo "No connection, creating one..."

        if [[ -s $VPN_FILE ]];then
            nmcli connection import type openvpn file $VPN_FILE
            nmcli connection modify "openvpn_bobby.valenzuela" vpn.user-name "bobby.valenzuela"
            nmcli connection modify "openvpn_bobby.valenzuela" +vpn.secrets ""
            nmcli connection modify "openvpn_bobby.valenzuela" +vpn.data "password-flags=2"
        else
            echo "No VPN file found at: $VPN_FILE"
            return 1
        fi

    fi

    # Connect/disconnect
    if [[ "${1}" == "off" ]]; then
        nmcli connection down "openvpn_bobby.valenzuela"
    else
        nmcli --ask connection up "openvpn_bobby.valenzuela"
    fi


}


alias openvpn="ut_o_openvpn"



ut_o_toggle-wifi-ipv6() {
    local wifi_conn
    local current_state
    local new_state

    wifi_conn=$(nmcli -t -f NAME,TYPE connection show --active |
        awk -F: '$2 == "802-11-wireless" {print $1; exit}')

    if [[ -z "$wifi_conn" ]]; then
        echo "Error: No active Wi-Fi connection found."
        return 1
    fi

    current_state=$(nmcli -g ipv6.method connection show "$wifi_conn")

    if [[ "$current_state" == "disabled" ]]; then
        new_state="auto"
    else
        new_state="disabled"
    fi

    echo "Wi-Fi: $wifi_conn"
    echo "Changing IPv6: $current_state -> $new_state"

    sudo nmcli connection modify "$wifi_conn" ipv6.method "$new_state" || return 1

    echo "Reconnecting Wi-Fi to apply changes..."
    nmcli connection down "$wifi_conn" &&
        nmcli connection up "$wifi_conn" &&
        echo "IPv6 is now $new_state"
}



