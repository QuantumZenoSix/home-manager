include "./cfg/animation.kdl"
include "./cfg/autostart.kdl"
include "./cfg/keybinds.kdl"
include "./cfg/input.kdl"
include "./cfg/display.kdl"
include "./cfg/layout.kdl"
include "./cfg/rules.kdl"
include "./cfg/misc.kdl"

// Note: xhost +SI:localuser:root is the standard workaround used across Arch, Fedora, Ubuntu, etc. on Wayland compositors for X11 compatibility (including Niri/Sway/Hyprland). 
spawn-sh-at-startup "xhost +SI:localuser:root"

// Monique monitor configuration
include "monitors.kdl"

// Force strix-g16 to use discrete gpus for all monitors
debug {
    render-drm-device "/dev/dri/renderD129"
}
