    window-rule {
        geometry-corner-radius 5 // Set every window radius to 
        clip-to-geometry true
    }

    layer-rule {
        // match namespace="^noctalia-wallpaper*"
        // Wallpaper is blurred in overview mode
        match namespace="^noctalia-backdrop$" // v5 (was ^noctalia-overview* in v4)
        place-within-backdrop true
    }
