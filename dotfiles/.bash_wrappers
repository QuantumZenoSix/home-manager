# Keep this at the end - this is a function that lets you fuzzy-find all my custom functions
# Command finder (cf)
command_finder(){
    eval $(compgen -c | grep -E '^(nx_|gt_|nv_|dk_|ut_)' | sort | fzf)
}
alias cf="command_finder"
