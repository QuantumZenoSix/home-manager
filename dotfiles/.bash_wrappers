#             Nix ('nx_')
# ────────────────────────────────────────────────


nx_up(){

    # Git to pull down the latest and greatest and update my local dotfiles via nix home-manager
    
    cd ~/.config/home-manager/

    # Add ssh-key to ssh-agent
    ut_ssh_reload_key

    # Stash anything lingering
    git stash save
    git pull
    git stash apply
    git add -A

    # Remove lazy-lock.json (and stale .backup copies) so HM's backup step can't collide
    nv_clear_lockfile

    home-manager switch -b backup --flake .#${USER}

    nv_clear_lockfile

    # Nix store files all have mtime 1, so Neovim's Lua bytecode cache can't detect
    # same-size edits and serves stale code. Clear it so the new config is picked up.
    rm -rf ~/.cache/nvim/luac

    # While I'm here, backup any niri/noctalia changes
    [[ -d ~/.config/niri/ ]] && cp -r ~/.config/niri/* ~/.config/home-manager/dotfiles/.config/niri/
    [[ -d ~/.config/noctalia/ ]] && cp -r ~/.config/noctalia/* ~/.config/home-manager/dotfiles/.config/noctalia/
    [[ -d ~/.config/shelly/ ]] && cp -r ~/.config/shelly/* ~/.config/home-manager/dotfiles/.config/shelly/
    [[ -d ~/.config/Kvantum/ ]] && cp -r ~/.config/Kvantum/* ~/.config/home-manager/dotfiles/.config/Kvantum/

    # Unstage everything so I can manually choose what to save
    git reset .

    cd -
}

