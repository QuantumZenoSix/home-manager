nv_clear_swaps(){
    find ~/.local/state/nvim/swap -iname "*.swp" -exec rm -v '{}' \;
}

nv_update_lazy(){
    sudo apt install ninja-build gettext cmake unzip curl git
    git clone https://github.com/neovim/neovim
    cd neovim
    git checkout stable
    make CMAKE_BUILD_TYPE=Release
    sudo make install
}

nv_edit_conf(){
    nvim ~/.config/home-manager/dotfiles/.config/nvim/lua/
}

nv_clear_lockfile(){
    # Perms get set to root if I accidentally sudo nvim

    # Fix ownership of the entire Neovim config (safest and most common fix)
    # sudo chown -R $USER:$USER ~/.config/nvim

    # If you want to be extra sure, also fix permissions
    # chmod -R u+rwX ~/.config/nvim

    rm -f ~/.config/nvim/lazy-lock.json*

}



