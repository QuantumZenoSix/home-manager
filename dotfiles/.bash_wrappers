}


nx_remove_home_manager(){
	nix run home-manager/master -- uninstall
    nix profile remove home-manager-path
    rm -rf ~/.local/state/nix/profiles/home-manager*
    rm -rf ~/.cache/home-manager
	rm -rf ~/.config/home-manager
    rm -rf ~/.config/nixpkgs
	nix-collect-garbage -d 
	nix-env --list-generations 
	nix-env --delete-generations &> /dev/null
    find ~ -maxdepth 2 -type l -lname '/nix/store/*' -exec rm -rf '{}' \;
}


